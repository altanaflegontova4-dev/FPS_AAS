  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7d83182d035c98a4c8b699880c155003, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NoteInteractable
  promptText: Press E to read
  noteImage: {fileID: 21300000, guid: 61680288a0bc9a946a7d5403955986df, type: 3}
  noteText: "SCRAPED NOTE (3/4)\n\nPersonal Journal\nDATE: January 12th\n\nI spent
    all day converting robot units into combat models. At first I thought it was
    just a one-time contract, but apparently the first \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588
    was a huge success. Now everyone wants more. The factory's busy again, nobody's
    talking about layoffs anymore, and management finally looks relieved. I should
    feel the same,  but I can't. We built these robots to protect people, not for
    \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588.
    I guess when money starts coming in, it's easier to stop asking questions.\n\n-
    M. Rivera (Engineer)"
  noteTitle: CEO Report
